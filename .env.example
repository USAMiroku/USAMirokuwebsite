# Frontend public configuration
VITE_GA4_ID=
VITE_SITE_URL=https://usa-mirokuwebsite.vercel.app

# Learning app (Supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional in local dev. Leave blank to call same-origin /api routes.
VITE_DONATION_API_BASE_URL=

# PayPal API mode: live or sandbox
PAYPAL_ENV=live

# Canonical website URL used for PayPal return/cancel links
SITE_URL=https://usa-mirokuwebsite.vercel.app

# Main donations PayPal REST app credentials
PAYPAL_DONATIONS_CLIENT_ID=
PAYPAL_DONATIONS_SECRET=

# Sangetsu payments PayPal REST app credentials
PAYPAL_SANGETSU_CLIENT_ID=
PAYPAL_SANGETSU_SECRET=

# Optional processing-fee coverage shown on the payment form.
# Defaults match PayPal Advanced Credit and Debit Card Payments style pricing; override to match your account.
PAYPAL_PROCESSING_FEE_COVER_ENABLED=true
PAYPAL_PROCESSING_FEE_PERCENT=0.0289
PAYPAL_PROCESSING_FEE_FIXED=0.29
